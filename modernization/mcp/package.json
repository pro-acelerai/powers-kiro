{
  "name": "@modernization/mcp",
  "version": "0.1.0",
  "description": "Modernization MCP Server — the Harness",
  "type": "module",
  "bin": {
    "modernization-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/bundle.cjs --external:jiti",
    "start": "node dist/index.js",
    "test": "node --import tsx/esm --test src/domain/state-machine.test.ts src/trace/session-store.test.ts src/harness/scope.test.ts src/context.test.ts"
  },
  "dependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
